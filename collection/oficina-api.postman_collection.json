    {
      "name": "Ordens de Serviço",
      "description": "Execute os requests nesta ordem para o fluxo completo:\nCriar → Iniciar Diagnóstico → Adicionar Itens → Gerar Orçamento → Aprovar → Finalizar → Entregar",
      "item": [
        {
          "name": "01 Criar OS: salva osId",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const problemas = [",
                  "    'Motor falhando ao acelerar',",
                  "    'Barulho ao frear',",
                  "    'Luz de injeção acesa no painel',",
                  "    'Ar condicionado não gela',",
                  "    'Vibração no volante em alta velocidade',",
                  "    'Vazamento de óleo no cárter',",
                  "    'Carro não pega a frio',",
                  "    'Suspensão fazendo barulho em lombadas',",
                  "    'Consumo de combustível elevado',",
                  "    'Fumaça azul ao arrancar'",
                  "];",
                  "pm.collectionVariables.set('_problema', problemas[Math.floor(Math.random()*problemas.length)]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OS criada (201) com status RECEBIDA', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('osId', j.id);",
                  "    pm.expect(j.status).to.eql('RECEBIDA');",
                  "    console.log('osId=' + j.id + ' | numero=' + j.numero + ' | problema: ' + j.descricaoProblema);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"documentoCliente\": \"{{clienteDocumento}}\",\n    \"placaVeiculo\": \"{{veiculoPlaca}}\",\n    \"descricaoProblema\": \"{{_problema}}\",\n    \"observacoes\": \"Cliente relatou problema recorrente\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/ordens-servico",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico"]
            }
          }
        },
        {
          "name": "02 Iniciar Diagnóstico (RECEBIDA -> EM_DIAGNOSTICO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status EM_DIAGNOSTICO', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('EM_DIAGNOSTICO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/iniciar-diagnostico",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "iniciar-diagnostico"]
            }
          }
        },
        {
          "name": "03 Adicionar Serviço à OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Serviço adicionado (200)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.itensServico.length).to.be.above(0);",
                  "    console.log('Itens serviço: ' + j.itensServico.length + ' | valorTotal: ' + j.valorTotal);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"servicoId\": {{servicoId}},\n    \"quantidade\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/servicos",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "servicos"]
            }
          }
        },
        {
          "name": "04 Adicionar Peça à OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Peça adicionada (200)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.itensPeca.length).to.be.above(0);",
                  "    console.log('Itens peça: ' + j.itensPeca.length + ' | valorTotal: ' + j.valorTotal);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pecaId\": {{pecaId}},\n    \"quantidade\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/pecas",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "pecas"]
            }
          }
        },
        {
          "name": "05 Gerar Orçamento (EM_DIAGNOSTICO -> AGUARDANDO_APROVACAO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status AGUARDANDO_APROVACAO', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.status).to.eql('AGUARDANDO_APROVACAO');",
                  "    console.log('Orçamento gerado | valorTotal: ' + j.valorTotal);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/gerar-orcamento",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "gerar-orcamento"]
            }
          }
        },
        {
          "name": "06 Aprovar ou Rejeitar Orçamento via Body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"aprovado\": true,\n    \"observacao\": \"Cliente aprovou o orçamento por telefone\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/aprovacao-orcamento",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "aprovacao-orcamento"]
            }
          }
        },
        {
          "name": "07 Finalizar OS (EM_EXECUCAO -> FINALIZADA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status FINALIZADA', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('FINALIZADA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/finalizar",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "finalizar"]
            }
          }
        },
        {
          "name": "08 Entregar Veículo (FINALIZADA -> ENTREGUE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status ENTREGUE', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ENTREGUE');",
                  "    console.log('Fluxo completo concluído!');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/entregar",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "entregar"]
            }
          }
        },
        {
          "name": "Listar OS Ativas (ordenadas por prioridade)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico"]
            }
          }
        },
        {
          "name": "Listar OS Ativas (endpoint dedicado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/ativas",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "ativas"]
            }
          }
        },
        {
          "name": "Buscar OS por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}"]
            }
          }
        },
        {
          "name": "Consultar Status (público — sem autenticação)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{osId}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "{{osId}}", "status"]
            }
          }
        },
        {
          "name": "Listar OS por Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/status/RECEBIDA",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "status", "RECEBIDA"],
              "query": [
                {
                  "key": "status",
                  "value": "RECEBIDA",
                  "description": "Valores: RECEBIDA | EM_DIAGNOSTICO | AGUARDANDO_APROVACAO | EM_EXECUCAO | FINALIZADA | ENTREGUE",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Estatísticas das OS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/estatisticas",
              "host": ["{{base_url}}"],
              "path": ["api", "ordens-servico", "estatisticas"]
            }
          }
        }
      ]
    }
  ]
}
