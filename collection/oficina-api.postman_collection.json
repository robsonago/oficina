{
  "info": {
    "name": "Oficina Mecânica",
    "_postman_id": "oficina-mecanica-fiap-fase2",
    "description": "Collection com geração automática de dados em cada execução.\n\n- CPF matematicamente válido gerado no pre-request\n- Placa aleatória (formato antigo ou Mercosul)\n- IDs capturados automaticamente e reutilizados nos requests seguintes\n- Execute em ordem de cima para baixo para o fluxo completo\n\nCompatível com Postman (scripts ativos) e Insomnia (import funciona; scripts de geração automática são ignorados).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",          "value": "http://localhost:8080", "type": "string" },
    { "key": "token",             "value": "",                      "type": "string" },
    { "key": "clienteId",         "value": "",                      "type": "string" },
    { "key": "clienteDocumento",  "value": "",                      "type": "string" },
    { "key": "veiculoId",         "value": "",                      "type": "string" },
    { "key": "veiculoPlaca",      "value": "",                      "type": "string" },
    { "key": "pecaId",            "value": "",                      "type": "string" },
    { "key": "servicoId",         "value": "",                      "type": "string" },
    { "key": "osId",              "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login: salva token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login realizado com sucesso', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('token', j.token);",
                  "    console.log('Token salvo. Role: ' + j.role);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Registrar Usuário (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"tecnico1\",\n    \"password\": \"senha123\",\n    \"role\": \"TECNICO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/registrar",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "registrar"]
            }
          }
        }
      ]
    },

    {
      "name": "Clientes",
      "item": [
        {
          "name": "Criar Cliente: salva clienteId + documento",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera CPF matematicamente válido (algoritmo Receita Federal)",
                  "function gerarCPF() {",
                  "    const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
                  "    let s = n.reduce((a, v, i) => a + v * (10 - i), 0);",
                  "    const d1 = s % 11 < 2 ? 0 : 11 - (s % 11);",
                  "    s = [...n, d1].reduce((a, v, i) => a + v * (11 - i), 0);",
                  "    const d2 = s % 11 < 2 ? 0 : 11 - (s % 11);",
                  "    return [...n, d1, d2].join('').replace(/(\\d{3})(\\d{3})(\\d{3})(\\d{2})/, '$1.$2.$3-$4');",
                  "}",
                  "const nomes = ['Ana Lima','Carlos Souza','Maria Santos','João Oliveira',",
                  "               'Paula Costa','Rafael Mendes','Fernanda Rocha','Bruno Alves',",
                  "               'Juliana Ferreira','Diego Martins','Carla Duarte','Lucas Pereira'];",
                  "const ruas  = ['das Flores','do Sol','da Paz','Verde','Azul','Nova','das Acácias'];",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('_cpf',          gerarCPF());",
                  "pm.collectionVariables.set('_nomeCliente',  nomes[Math.floor(Math.random()*nomes.length)] + ' #' + ts.toString().slice(-4));",
                  "pm.collectionVariables.set('_emailCliente', 'cliente' + ts + '@oficina.test');",
                  "pm.collectionVariables.set('_telefone',     '119' + Math.floor(Math.random()*90000000 + 10000000));",
                  "pm.collectionVariables.set('_endereco',     'Rua ' + ruas[Math.floor(Math.random()*ruas.length)] + ', ' + Math.floor(Math.random()*999+1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cliente criado (201)', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('clienteId',        j.id);",
                  "    pm.collectionVariables.set('clienteDocumento', pm.collectionVariables.get('_cpf'));",
                  "    console.log('clienteId=' + j.id + ' | documento=' + pm.collectionVariables.get('_cpf'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nome\": \"{{_nomeCliente}}\",\n    \"documento\": \"{{_cpf}}\",\n    \"email\": \"{{_emailCliente}}\",\n    \"telefone\": \"{{_telefone}}\",\n    \"endereco\": \"{{_endereco}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/clientes",
              "host": ["{{base_url}}"],
              "path": ["api", "clientes"]
            }
          }
        },
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/clientes",
              "host": ["{{base_url}}"],
              "path": ["api", "clientes"]
            }
          }
        },
        {
          "name": "Buscar Cliente por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/clientes/{{clienteId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "clientes", "{{clienteId}}"]
            }
          }
        },
        {
          "name": "Buscar Cliente por Documento",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/clientes/documento/{{clienteDocumento}}",
              "host": ["{{base_url}}"],
              "path": ["api", "clientes", "documento", "{{clienteDocumento}}"]
            }
          }
        },
        {
          "name": "Atualizar Cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nome\": \"{{_nomeCliente}} Atualizado\",\n    \"documento\": \"{{clienteDocumento}}\",\n    \"email\": \"upd.{{_emailCliente}}\",\n    \"telefone\": \"{{_telefone}}\",\n    \"endereco\": \"{{_endereco}} - Apto 2\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/clientes/{{clienteId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "clientes", "{{clienteId}}"]
            }
          }
        },
        {
          "name": "Desativar Cliente",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/clientes/{{clienteId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "clientes", "{{clienteId}}"]
            }
          }
        }
      ]
    },

    {
      "name": "Veículos",
      "item": [
        {
          "name": "Criar Veículo: salva veiculoId + placa",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera placa aleatória (formato antigo ABC1234 ou Mercosul ABC1D23)",
                  "function gerarPlaca() {",
                  "    const L = () => 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[Math.floor(Math.random()*26)];",
                  "    const D = () => Math.floor(Math.random()*10);",
                  "    return Math.random() > 0.5",
                  "        ? `${L()}${L()}${L()}${D()}${D()}${D()}${D()}`",
                  "        : `${L()}${L()}${L()}${D()}${L()}${D()}${D()}`;",
                  "}",
                  "const fabricantes = [",
                  "    { marca: 'Toyota',     modelos: ['Corolla','Hilux','Yaris','RAV4'] },",
                  "    { marca: 'Honda',      modelos: ['Civic','HR-V','Fit','City'] },",
                  "    { marca: 'Chevrolet',  modelos: ['Onix','Cruze','S10','Tracker'] },",
                  "    { marca: 'Volkswagen', modelos: ['Gol','Polo','T-Cross','Virtus'] },",
                  "    { marca: 'Ford',       modelos: ['Ka','EcoSport','Ranger','Bronco'] },",
                  "    { marca: 'Hyundai',    modelos: ['HB20','Creta','Tucson'] },",
                  "    { marca: 'Fiat',       modelos: ['Argo','Mobi','Toro','Pulse'] }",
                  "];",
                  "const f = fabricantes[Math.floor(Math.random()*fabricantes.length)];",
                  "pm.collectionVariables.set('_placa',  gerarPlaca());",
                  "pm.collectionVariables.set('_marca',  f.marca);",
                  "pm.collectionVariables.set('_modelo', f.modelos[Math.floor(Math.random()*f.modelos.length)]);",
                  "pm.collectionVariables.set('_ano',    2015 + Math.floor(Math.random()*10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Veículo criado (201)', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('veiculoId',    j.id);",
                  "    pm.collectionVariables.set('veiculoPlaca', pm.collectionVariables.get('_placa'));",
                  "    console.log('veiculoId=' + j.id + ' | placa=' + pm.collectionVariables.get('_placa'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"placa\": \"{{_placa}}\",\n    \"marca\": \"{{_marca}}\",\n    \"modelo\": \"{{_modelo}}\",\n    \"ano\": {{_ano}},\n    \"clienteId\": {{clienteId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/veiculos",
              "host": ["{{base_url}}"],
              "path": ["api", "veiculos"]
            }
          }
        },
        {
          "name": "Listar Veículos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/veiculos",
              "host": ["{{base_url}}"],
              "path": ["api", "veiculos"]
            }
          }
        },
        {
          "name": "Buscar Veículo por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/veiculos/{{veiculoId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "veiculos", "{{veiculoId}}"]
            }
          }
        },
        {
          "name": "Buscar Veículo por Placa",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/veiculos/placa/{{veiculoPlaca}}",
              "host": ["{{base_url}}"],
              "path": ["api", "veiculos", "placa", "{{veiculoPlaca}}"]
            }
          }
