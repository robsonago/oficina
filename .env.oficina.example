# =====================================================================
# Variáveis de ambiente da Oficina Mecânica — ARQUIVO DE EXEMPLO
# Simula um cofre de segredos (ex: AWS Secrets Manager)
#
# Copie este arquivo para ".env.oficina" (que não é versionado no Git)
# antes de rodar docker-compose:
#   cp .env.oficina.example .env.oficina
#   docker-compose --env-file .env.oficina up -d --build
#
# Em produção, esses valores viriam do AWS Secrets Manager,
# Azure Key Vault ou GCP Secret Manager — nunca hardcoded.
# =====================================================================

# Banco de dados
DB_URL=jdbc:postgresql://postgres:5432/oficina
DB_USERNAME=oficina
DB_PASSWORD=oficina123

# JWT (troque por uma chave própria em qualquer ambiente real)
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVFN5c3RlbU9maWNpbmFNZWNhbmljYTIwMjQ=
JWT_EXPIRATION=86400000

# E-mail (Mailpit — local/dev, sem autenticação)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=oficina@localhost

# E-mail (Gmail — produção, exemplo)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-de-app
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=seu-email@gmail.com

# JVM flags extras (opcional)
# JAVA_OPTS=-Xmx512m
