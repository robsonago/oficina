# =====================================================================
# Variáveis opcionais para o docker compose (Fase 4)
#
# O docker-compose.yml já funciona sem nenhum arquivo .env: os valores
# padrão sobem o ambiente local completo com pagamento simulado.
# Copie para ".env" (não versionado) só se quiser trocar algo:
#   cp .env.oficina.example .env
#   docker compose up -d --build
# =====================================================================

# Chave do JWT (a mesma é usada pelos três serviços)
# JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVFN5c3RlbU9maWNpbmFNZWNhbmljYTIwMjQ=

# Pagamento real no Billing (sandbox do Mercado Pago)
# PAGAMENTO_PROVIDER=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# MERCADOPAGO_NOTIFICATION_URL=https://<url-publica>/api/pagamentos/webhook
